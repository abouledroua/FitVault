{
  "name": "fitvault-web",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:standalone": "next build && node scripts/prepare-standalone.cjs",
    "start": "next start",
    "lint": "eslint",
    "start-electron": "electron .",
    "dist": "npm run build:standalone && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "date-fns": "^4.4.0",
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.53.0",
    "mysql2": "^3.24.5",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-barcode": "^1.6.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-datepicker": "^6.2.0",
    "@types/react-dom": "^19",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.fitvault.app",
    "productName": "FitVault",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "electron/**/*",
      "public/app.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.png",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FitVault"
    }
  }
}
